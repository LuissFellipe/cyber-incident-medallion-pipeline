# =============================================================================
# Variáveis de Ambiente - Cybersecurity Data Pipeline
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# NÃO faça commit do arquivo ".env" em repositórios públicos.
# =============================================================================

# ---------------------------------------------------------------------------
# MinIO / S3 Credentials
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=password123

# Região (necessária para DuckDB httpfs; MinIO ignora, mas precisa ser definida)
MINIO_REGION=us-east-1

# ---------------------------------------------------------------------------
# Caminhos do Dataset
# ---------------------------------------------------------------------------
# Caminho local do CSV bruto de origem
RAW_CSV_PATH=data/cybersecurity_attacks.csv

# ---------------------------------------------------------------------------
# Paths S3 (Arquitetura Medallion)
# ---------------------------------------------------------------------------
BRONZE_PATH=s3://bronze/cyber_attacks_raw.parquet
SILVER_PATH=s3://silver/cyber_attacks_clean.parquet
GOLD_PATH=s3://gold/fact_incident_summary.parquet
